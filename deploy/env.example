# NetPing Dashboard — runtime environment.
# Copied to /etc/ping-app/env by install.sh. Edit there.

# --- Network ----------------------------------------------------------------
# Bind to all interfaces (LAN-trust model — keep this on a trusted LAN).
PING_BIND_HOST=0.0.0.0
PING_PORT=8000

# Origins allowed for cross-origin browser requests. Empty list = same-origin
# only. Example: PING_CORS_ORIGINS='["http://nas.lan","http://laptop.lan"]'
# PING_CORS_ORIGINS=[]

# --- Storage ----------------------------------------------------------------
PING_DB_PATH=/var/lib/ping-app/ping.db
PING_SAMPLE_RETENTION_DAYS=7
PING_EVENT_RETENTION_DAYS=30

# --- Pinger -----------------------------------------------------------------
PING_MAX_CONCURRENT_PINGS=64
PING_DEFAULT_INTERVAL_S=1.0
PING_PING_TIMEOUT_S=2.0
PING_SLOW_THRESHOLD_MS=100.0

# --- Writer -----------------------------------------------------------------
PING_WRITE_FLUSH_INTERVAL_S=0.5
PING_WRITE_FLUSH_MAX_BATCH=1000

# --- Frontend ---------------------------------------------------------------
PING_LANGUAGE_DEFAULT=en
